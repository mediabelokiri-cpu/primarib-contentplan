# Supabase Public Credentials (Safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local Development Mode (Set to true when developing locally without Supabase connection)
NEXT_PUBLIC_LOCAL_DEMO_MODE=true

# ============================================================================
# HYBRID AI PROVIDER CREDENTIALS (STRICTLY SERVER-SIDE - NEVER LEAKED TO CLIENT)
# ============================================================================

