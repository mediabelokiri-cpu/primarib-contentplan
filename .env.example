# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# 2. OpenAI API (Optional Fallback / Reasoning)
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# 3. Anthropic Claude API (Optional Fallback for Copywriting)
